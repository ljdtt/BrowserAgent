# Required: Alibaba Cloud Bailian API Key
# Get it from: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your_api_key_here

# Optional settings
MODEL_NAME=qwen-plus
BROWSER_TYPE=msedge
HEADLESS=true
MAX_STEPS=15
MAX_INVALID_CALLS=2
MAX_NO_PROGRESS=3
TASK_TIMEOUT_SECONDS=180
ARTIFACT_DIR=artifacts
